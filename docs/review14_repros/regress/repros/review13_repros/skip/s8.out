  cap 100: ['https://x/in-network-rates.json.gz', 'https://x/other.json.gz', 'https://x/allowed-amounts.json.gz', 'https://x/rx_formulary.json.gz', 'https://x/drug-free-workplace_in-network.json.gz']
  cap 2  : ['https://x/in-network-rates.json.gz', 'https://x/other.json.gz']
