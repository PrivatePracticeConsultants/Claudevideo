# Copy to esphome/secrets.yaml (gitignored). ESPHome keeps its own secrets file
# separate from Home Assistant's.
wifi_ssid: "YourNetwork"
wifi_password: "changeme"
fallback_password: "changeme"
ota_password: "changeme"
# MUST be base64 of exactly 32 bytes or the node refuses the config.
# This all-zeros key is a valid-format placeholder — replace it:
#   openssl rand -base64 32
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
