# Copy to .env beside docker-compose.yml. .env is gitignored — it holds the
# broker credentials in cleartext for docker compose.
#
# These MUST match:
#   - the Mosquitto password file (mosquitto/config/passwd)
#   - mqtt_username / mqtt_password in secrets.yaml
#   - the credentials entered into ring-mqtt on first run
# See docs/prompts/22-ring.md step 2.

MQTT_USERNAME=hass
MQTT_PASSWORD=changeme-generate-a-long-random-password
