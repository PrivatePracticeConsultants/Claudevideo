# Copy to secrets.yaml and fill in. secrets.yaml is gitignored and must never
# be committed. Every key referenced by a !secret in this repo appears here.

home_name: "Home"
home_latitude: 0.0
home_longitude: 0.0
home_elevation: 0
home_time_zone: "America/New_York"

# Set by prompt 17 (remote access). Recorded in docs/decisions.md.
external_url: "https://example.duckdns.org"
internal_url: "http://homeassistant.local:8123"

# Alarm panel code (prompt 08). Digits only; HA compares it as a string.
alarm_code: "1234"

# MQTT broker (Ring Alarm bridge). Must match mosquitto/config/passwd, the
# .env beside docker-compose.yml, and the credentials given to ring-mqtt.
# The Ring REFRESH TOKEN is deliberately NOT here — it lives in ring-mqtt's
# /data volume (ring-state.json). See docs/decisions.md.
mqtt_username: "hass"
mqtt_password: "changeme-generate-a-long-random-password"
