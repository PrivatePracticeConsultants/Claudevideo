; LAST LINE - roguelite tower defense
; Engine configuration. Gameplay/balance values do NOT belong here; they live in
; res://data/*.json (see DECISIONS.md, "zero balance constants in code").

config_version=5

[application]

config/name="LAST LINE"
config/description="Roguelite tower defense. Phase P0."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

; What Godot writes into a texture's .import the FIRST time it sees it, so a
; fresh clone imports the sprites correctly instead of importing them wrong and
; waiting to be noticed.
;
; Every sprite in this game is a texture on a quad lying almost flat in a 3D
; scene, so it is permanently minified, and both engine defaults are wrong for
; that - silently, which is the problem:
;
;   mipmaps/generate defaults false. The renderer asks for LINEAR_WITH_MIPMAPS;
;   with no mip chain Godot does not warn, it just falls back to plain linear.
;   The art shimmers and reads as pixelated. Turning mipmaps on also measured
;   FASTER (84.0 -> 72.5 ms a frame) - a minified texture with no mips thrashes
;   the sampler cache.
;
;   detect_3d/compress_to defaults 1. The first time a texture is used in 3D,
;   Godot REWRITES its own .import to VRAM compression. On flat cel-shaded art
;   with hard outlines that is visible block noise, and it happens on whatever
;   machine ran the game last.
;
; Both were fixed by hand once and both came back, because the .import files
; were gitignored and the next clone regenerated the defaults. This is the
; durable half of that fix; the sidecars are now committed too, and
; tests/cases/test_art_import.gd fails if either setting drifts.
texture={
"detect_3d/compress_to": 0,
"mipmaps/generate": true
}

[rendering]

; Desktop runs Forward+, the web build runs Compatibility, and that split is the
; whole point: SSAO, high-quality shadow filtering and the better glow pass only
; exist on Forward+, and Forward+ does not target WebGL. Pinning the base method
; to forward_plus therefore costs the web build nothing - the ".web" override
; below is what the web export actually reads.
;
; The ".web" and ".mobile" overrides are ENGINE defaults, not ours: a project
; that writes neither still reports gl_compatibility on those platforms
; (verified against 4.5 with both lines deleted). They are written out anyway so
; that the split is visible to whoever opens this file, rather than being a
; property of a Godot version.
;
; The renderer decides this at load, so nothing in render/ hard-codes it.
; sim_renderer_3d.gd asks RenderingServer.get_rendering_device() != null and
; enables SSAO only where a RenderingDevice exists.
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
