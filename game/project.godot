; LAST LINE - roguelite tower defense
; Engine configuration. Gameplay/balance values do NOT belong here; they live in
; res://data/*.json (see DECISIONS.md, "zero balance constants in code").

config_version=5

[application]

config/name="LAST LINE"
config/description="Roguelite tower defense. Phase P0."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
