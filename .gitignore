# Anchored to the repo root on purpose: these are MRF Explorer's runtime store
# dirs (config/mrfx.yaml resolves them relative to the repo root). Unanchored,
# `data/` also swallowed game/data/, which is where every balance constant in
# LAST LINE lives -- those JSON files must be tracked.
/data/
/data/raw/
/data/out/
